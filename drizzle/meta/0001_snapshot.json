      "checkConstraints": {
        "properties_publication_status_check": {
          "name": "properties_publication_status_check",
          "value": "\"properties\".\"publication_status\" IN ('draft', 'in_review', 'approved', 'published', 'archived')"
        },
        "properties_commercial_status_check": {
          "name": "properties_commercial_status_check",
          "value": "\"properties\".\"commercial_status\" IN ('available', 'offer_received', 'reserved', 'sold')"
        },
        "properties_price_mode_check": {
          "name": "properties_price_mode_check",
          "value": "\"properties\".\"price_mode\" IN ('exact', 'negotiable', 'contact')"
        },
        "properties_location_precision_check": {
          "name": "properties_location_precision_check",
          "value": "\"properties\".\"location_precision\" IN ('exact', 'approximate')"
        },
        "properties_code_not_blank_check": {
          "name": "properties_code_not_blank_check",
          "value": "length(trim(\"properties\".\"code\")) > 0"
        },
        "properties_currency_code_check": {
          "name": "properties_currency_code_check",
          "value": "\"properties\".\"currency_code\" IS NULL OR \"properties\".\"currency_code\" GLOB '[A-Z][A-Z][A-Z]'"
        },
        "properties_price_amount_minor_check": {
          "name": "properties_price_amount_minor_check",
          "value": "\"properties\".\"price_amount_minor\" IS NULL OR \"properties\".\"price_amount_minor\" >= 0"
        },
        "properties_area_square_meters_check": {
          "name": "properties_area_square_meters_check",
          "value": "\"properties\".\"area_square_meters\" IS NULL OR \"properties\".\"area_square_meters\" > 0"
        },
        "properties_private_latitude_check": {
          "name": "properties_private_latitude_check",
          "value": "\"properties\".\"private_latitude\" IS NULL OR \"properties\".\"private_latitude\" BETWEEN -90 AND 90"
        },
        "properties_private_longitude_check": {
          "name": "properties_private_longitude_check",
          "value": "\"properties\".\"private_longitude\" IS NULL OR \"properties\".\"private_longitude\" BETWEEN -180 AND 180"
        },
        "properties_public_latitude_check": {
          "name": "properties_public_latitude_check",
          "value": "\"properties\".\"public_latitude\" IS NULL OR \"properties\".\"public_latitude\" BETWEEN -90 AND 90"
        },
        "properties_public_longitude_check": {
          "name": "properties_public_longitude_check",
          "value": "\"properties\".\"public_longitude\" IS NULL OR \"properties\".\"public_longitude\" BETWEEN -180 AND 180"
        }
      }
