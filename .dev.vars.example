# CodeLoba - variables locales de desarrollo (plantilla).
#
# Copia este archivo como `.dev.vars` y rellena los valores reales.
# `.dev.vars` esta en .gitignore y NUNCA debe subirse al repositorio.
#
# En Cloudflare, los valores de produccion se cargan como secrets:
#   wrangler secret put NOMBRE_DE_LA_VARIABLE
#
# Hoy el proyecto lee ADMIN_DEV_BYPASS y las dos variables de Cloudflare
# Access. Las demas quedan documentadas porque haran falta mas adelante:

# Abre el panel (/admin/*) y su API (/api/admin/*) SOLO en desarrollo local.
# NO basta con ponerla a "true": ademas hace falta una build en modo DEV.
# Una build productiva la ignora, asi que no puede abrir nada por error.
# Aun asi, NUNCA debe definirse en el despliegue productivo.
ADMIN_DEV_BYPASS=false

# Cloudflare Access. Fuera del bypass local, el admin exige AMBAS: si falta
# cualquiera de las dos, toda peticion administrativa se rechaza con 403.
# Se rellenan cuando exista la Access Application; todavia no esta creada,
# asi que aqui van vacias a proposito y no hay valores de ejemplo que
# parezcan funcionales.
#
#   CF_ACCESS_TEAM_DOMAIN: origin HTTPS del equipo Zero Trust,
#                          https://<equipo>.cloudflareaccess.com
#   CF_ACCESS_AUD:         audience tag de la Access Application
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Entorno logico de la aplicacion (development | production)
# APP_ENV="development"

# Aviso de consultas nuevas por email (Resend). Sin estas dos, el formulario
# publico sigue funcionando y la consulta se guarda igual: solo no se envia el
# aviso, y queda registrado en el log del Worker.
#
#   RESEND_API_KEY:      clave de la API de Resend (empieza por `re_`)
#   CONTACT_FROM_EMAIL:  remitente verificado en Resend
#
# El DESTINATARIO no va aqui: sale de la configuracion del sitio
# (`site_settings.notifications_email`), porque lo cambia quien lleva el
# negocio, no un despliegue.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# El token publico de Mapbox NO va aqui: lo necesita el BUILD, no el Worker.
# Vive en `.env` (ver `.env.example`) como PUBLIC_MAPBOX_TOKEN.

# Credenciales del panel de administracion - fase de autenticacion
# ADMIN_SESSION_SECRET=""
