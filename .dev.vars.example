# CodeLoba - variables locales de desarrollo (plantilla).
#
# Copia este archivo como `.dev.vars` y rellena los valores reales.
# `.dev.vars` esta en .gitignore y NUNCA debe subirse al repositorio.
#
# En Cloudflare, los valores de produccion se cargan como secrets:
#   wrangler secret put NOMBRE_DE_LA_VARIABLE
#
# La unica variable que el proyecto lee hoy es ADMIN_DEV_BYPASS.
# Las demas quedan documentadas porque haran falta mas adelante:

# Abre la API administrativa (/api/admin/*) SOLO en desarrollo local.
# Sin esta variable a "true", la API responde 403.
# NUNCA debe definirse en el despliegue productivo.
ADMIN_DEV_BYPASS=false

# Entorno logico de la aplicacion (development | production)
# APP_ENV="development"

# Clave de envio de emails de contacto (Resend) - fase de formularios
# RESEND_API_KEY=""

# Token publico de Mapbox - fase de mapa
# PUBLIC_MAPBOX_TOKEN=""

# Credenciales del panel de administracion - fase de autenticacion
# ADMIN_SESSION_SECRET=""
