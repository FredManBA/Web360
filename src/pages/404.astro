---
import PublicLayout from '../layouts/PublicLayout.astro';
import NotFound from '../components/public/NotFound.astro';
import { labelsFor } from '../lib/public/labels';
import { brandOf, notFoundSeo } from '../lib/public/seo';
import { loadRuntimePublicSnapshot } from '../lib/public/snapshot';
import { DEFAULT_LOCALE } from '../lib/public/home';
import { localeFromPath } from '../lib/public/not-found';

export const prerender = false;
const fromPath = localeFromPath(Astro.url.pathname);
const locale = fromPath ?? DEFAULT_LOCALE;
const labels = labelsFor(locale);
const snapshot = await loadRuntimePublicSnapshot();
const seo = notFoundSeo({
  locale,
  brand: brandOf(snapshot.site, locale),
  title: labels.notFoundTitle,
  description: labels.notFoundLead,
});
Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'no-store');
---

<PublicLayout site={snapshot.site} seo={seo}>
  <NotFound locale={locale} offerOtherLanguage={fromPath === null} />
</PublicLayout>
