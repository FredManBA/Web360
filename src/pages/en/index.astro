---
import HomeContactCta from '../../components/public/HomeContactCta.astro';
import HomeExplore from '../../components/public/HomeExplore.astro';
import HomeHero from '../../components/public/HomeHero.astro';
import PropertyCard from '../../components/public/PropertyCard.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import {
  featuredOf,
  hasPlacedProperties,
  homeCopy,
  homeExploreSlides,
} from '../../lib/public/home';
import { labelsFor, locationLine } from '../../lib/public/labels';
import { catalogueHref, catalogueOf } from '../../lib/public/read-model';
import { sectionSeo } from '../../lib/public/seo';
import { loadRuntimePublicSnapshot } from '../../lib/public/snapshot';
import { organizationJsonLd } from '../../lib/public/structured-data';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const locale = 'en' as const;
const labels = labelsFor(locale);

const snapshot = await loadRuntimePublicSnapshot();
const properties = catalogueOf(snapshot, locale);

const copy = homeCopy(snapshot.site, locale, {
  brand: labels.brandName,
  heroTitle: labels.homeHeroTitle,
  heroSubtitle: labels.homeHeroSubtitle,
  seoTitle: labels.homeSeoTitle,
  seoDescription: labels.homeSeoDescription,
});

const featured = featuredOf(properties);
const showMap = hasPlacedProperties(properties);

/* Destacadas con recorrido: su foto de portada y el panorama inicial. */
const exploreSlides = homeExploreSlides(
  snapshot.properties[locale],
  (property) => locationLine(property.location),
  (property) => labels.imageOf(property.title),
);

const seo = sectionSeo({
  locale,
  brand: copy.brand,
  title: copy.seoTitle,
  description: copy.seoDescription,
  path: '/en/',
  alternatePath: '/es/',
  isHome: true,
  socialImage: snapshot.site.media.social,
});

/*
 * La organizacion se declara solo con lo que hay configurado de verdad:
 * si no hay ni nombre, no se emite nada.
 */
const jsonLd = organizationJsonLd({
  site: snapshot.site,
  contact: snapshot.contact,
  locale,
  url: Astro.site === undefined ? '/en/' : new URL('/en/', Astro.site).href,
});
---

<PublicLayout site={snapshot.site} seo={seo} jsonLd={jsonLd}>
  <HomeHero copy={copy} locale={locale} showMap={showMap} image={snapshot.site.media.hero} />

  <div class="home">
    <section class="home-section home-featured" aria-label={labels.homeFeaturedTitle}>
      {
        featured.length === 0 ? (
          /* Sin seleccion la portada no se rompe: se dice y se sigue. */
          <p class="home-empty">{labels.homeFeaturedEmpty}</p>
        ) : (
          <ul class="property-list home-featured-list">
            {featured.map((property) => (
              <li>
                <PropertyCard property={property} locale={locale} />
              </li>
            ))}
          </ul>
        )
      }

      {
        properties.length > 0 && (
          <p class="home-more">
            <a class="home-link" href={catalogueHref(locale)}>
              {labels.homeSeeAll} →
            </a>
          </p>
        )
      }
    </section>

    {
      (showMap || exploreSlides.length > 0) && (
        <HomeExplore locale={locale} slides={exploreSlides} showMap={showMap} />
      )
    }

    <HomeContactCta locale={locale} />
  </div>
</PublicLayout>

<script>
  import { initHomeExplore } from '../../lib/public/home-explore';
  import { initLanguagePreference } from '../../lib/public/language-preference';

  initHomeExplore();
  initLanguagePreference();
</script>
