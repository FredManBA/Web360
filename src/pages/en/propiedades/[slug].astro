---
import PropertyDetail from '../../../components/public/PropertyDetail.astro';
import NotFound from '../../../components/public/NotFound.astro';
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { alternateHref, findBySlug } from '../../../lib/public/read-model';
import { labelsFor } from '../../../lib/public/labels';
import { brandOf, propertySeo, notFoundSeo } from '../../../lib/public/seo';
import { loadRuntimePublicSnapshot } from '../../../lib/public/snapshot';
import { propertyJsonLd } from '../../../lib/public/structured-data';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const locale = 'en' as const;
const snapshot = await loadRuntimePublicSnapshot();
const property = findBySlug(snapshot, locale, Astro.params.slug ?? '');
const alternate = property === null ? null : alternateHref(snapshot, locale, property.slug);
const labels = labelsFor(locale);
const seo =
  property === null
    ? notFoundSeo({
        locale,
        brand: brandOf(snapshot.site, locale),
        title: labels.notFoundTitle,
        description: labels.notFoundLead,
      })
    : propertySeo(
        property,
        locale,
        brandOf(snapshot.site, locale),
        alternate,
        snapshot.site.media.social,
      );
const url = (path: string): string =>
  Astro.site === undefined ? path : new URL(path, Astro.site).href;
const jsonLd =
  property === null
    ? null
    : propertyJsonLd({
        property,
        locale,
        url: url(property.href),
        images: property.media.items
          .map((item) => item.url)
          .filter((item): item is string => item !== null)
          .map(url),
      });
if (property === null) Astro.response.status = 404;
---

<PublicLayout site={snapshot.site} seo={seo} section="properties" jsonLd={jsonLd}>
  {
    property === null ? (
      <NotFound locale={locale} />
    ) : (
      <div class="page">
        <PropertyDetail property={property} locale={locale} channels={snapshot.contact} />
      </div>
    )
  }
</PublicLayout>

<script>
  import { initPropertyDetail } from '../../../lib/public/detail-page';
  import { initLanguagePreference } from '../../../lib/public/language-preference';
  import { initContactForm } from '../../../lib/public/contact-form';
  import { initPropertyMap } from '../../../lib/public/map-page';

  initLanguagePreference();
  initContactForm();
  initPropertyDetail();
  initPropertyMap();
</script>
