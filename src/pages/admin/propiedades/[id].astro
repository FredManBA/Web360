---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { COMMERCIAL_STATUSES } from '../../../lib/domain/vocabularies';
import { COMMERCIAL_STATUS_LABELS } from '../../../lib/admin/ui/labels';
import { SUPPORTED_CURRENCY_CODES } from '../../../lib/domain/money';

/** Etiquetas humanas; los identificadores internos no se muestran. */
const PRICE_MODE_OPTIONS = [
  { value: 'exact', label: 'Precio exacto' },
  { value: 'negotiable', label: 'Negociable' },
  { value: 'contact', label: 'Consultar' },
] as const;

const PRECISION_OPTIONS = [
  { value: 'exact', label: 'Exacta' },
  { value: 'approximate', label: 'Aproximada' },
] as const;

export const prerender = false;

const { id } = Astro.params;

/*
 * El shell se renderiza en el servidor; la propiedad la carga el navegador
 * contra `/api/admin/properties/:id`, para no saltarse la capa HTTP.
 */
---

<AdminLayout title="Editar propiedad">
  <p class="editor-back">
    <a href="/admin/propiedades">← Propiedades</a>
  </p>

  <div id="admin-editor" data-property-id={id}>
    <div id="editor-state" aria-live="polite">
      <div class="admin-state"><p>Cargando propiedad…</p></div>
    </div>

    <div class="editor-header admin-panel" id="editor-header"></div>

    <form id="editor-form" class="editor-form admin-panel" hidden>
      <h2>Información básica</h2>

      <div class="admin-field">
        <label for="field-code">Código</label>
        <input
          type="text"
          id="field-code"
          name="code"
          maxlength="64"
          required
          aria-describedby="field-code-help field-code-error"
          aria-invalid="false"
        />
        <p class="editor-help" id="field-code-help">
          Se genera automáticamente, pero puedes modificarlo.
        </p>
        <p class="editor-error" id="field-code-error" hidden></p>
      </div>

      <div class="admin-field">
        <label for="field-type">Tipo de propiedad</label>
        <select id="field-type" name="propertyTypeId">
          <option value="">Sin tipo</option>
        </select>
      </div>

      <div class="admin-field">
        <label for="field-commercial">Estado comercial</label>
        <select id="field-commercial" name="commercialStatus">
          {
            COMMERCIAL_STATUSES.map((status) => (
              <option value={status}>{COMMERCIAL_STATUS_LABELS[status]}</option>
            ))
          }
        </select>
      </div>

      <div class="editor-check">
        <input type="checkbox" id="field-featured" name="isFeatured" />
        <label for="field-featured">Mostrar como propiedad destacada</label>
      </div>

      <div class="editor-check">
        <input
          type="checkbox"
          id="field-show-when-sold"
          name="showWhenSold"
          aria-describedby="field-show-when-sold-help"
        />
        <label for="field-show-when-sold">Mantener visible cuando esté vendida</label>
        <p class="editor-help" id="field-show-when-sold-help">
          Si se desactiva, una propiedad vendida no aparecerá públicamente.
        </p>
      </div>

      <h2>Precio y superficie</h2>

      <div class="admin-field">
        <label for="field-price-mode">Modo de precio</label>
        <select id="field-price-mode" name="priceMode">
          {PRICE_MODE_OPTIONS.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
      </div>

      <div class="editor-row" id="price-amount-row">
        <div class="admin-field">
          <label for="field-price-amount">Precio</label>
          <input
            type="text"
            inputmode="decimal"
            id="field-price-amount"
            name="priceAmount"
            aria-describedby="field-price-amount-preview field-price-amount-error"
            aria-invalid="false"
          />
          <p class="editor-help" id="field-price-amount-preview"></p>
          <p class="editor-error" id="field-price-amount-error" hidden></p>
        </div>

        <div class="admin-field">
          <label for="field-currency">Moneda</label>
          <select
            id="field-currency"
            name="currencyCode"
            aria-describedby="field-currency-error"
            aria-invalid="false"
          >
            <option value="">Sin moneda</option>
            {SUPPORTED_CURRENCY_CODES.map((code) => <option value={code}>{code}</option>)}
          </select>
          <p class="editor-error" id="field-currency-error" hidden></p>
        </div>
      </div>

      <div class="admin-field">
        <label for="field-area">Superficie (m²)</label>
        <input
          type="text"
          inputmode="decimal"
          id="field-area"
          name="areaSquareMeters"
          aria-describedby="field-area-preview field-area-error"
          aria-invalid="false"
        />
        <p class="editor-help" id="field-area-preview"></p>
        <p class="editor-error" id="field-area-error" hidden></p>
      </div>

      <h2>Ubicación</h2>

      <div class="editor-row">
        <div class="admin-field">
          <label for="field-province">Provincia</label>
          <input type="text" id="field-province" name="province" maxlength="120" />
        </div>
        <div class="admin-field">
          <label for="field-canton">Cantón</label>
          <input type="text" id="field-canton" name="canton" maxlength="120" />
        </div>
      </div>

      <div class="editor-row">
        <div class="admin-field">
          <label for="field-district">Distrito</label>
          <input type="text" id="field-district" name="district" maxlength="120" />
        </div>
        <div class="admin-field">
          <label for="field-locality">Localidad</label>
          <input type="text" id="field-locality" name="locality" maxlength="120" />
        </div>
      </div>

      <fieldset class="editor-fieldset">
        <legend>Coordenadas privadas</legend>
        <p class="editor-help" id="private-coords-help">
          Estas coordenadas son internas y nunca se usan como ubicación pública automáticamente.
        </p>

        <div class="editor-row">
          <div class="admin-field">
            <label for="field-private-lat">Latitud privada</label>
            <input
              type="text"
              inputmode="decimal"
              id="field-private-lat"
              name="privateLatitude"
              aria-describedby="private-coords-help field-private-lat-error"
              aria-invalid="false"
            />
            <p class="editor-error" id="field-private-lat-error" hidden></p>
          </div>
          <div class="admin-field">
            <label for="field-private-lng">Longitud privada</label>
            <input
              type="text"
              inputmode="decimal"
              id="field-private-lng"
              name="privateLongitude"
              aria-describedby="private-coords-help field-private-lng-error"
              aria-invalid="false"
            />
            <p class="editor-error" id="field-private-lng-error" hidden></p>
          </div>
        </div>
      </fieldset>

      <fieldset class="editor-fieldset">
        <legend>Ubicación pública</legend>
        <p class="editor-help" id="public-coords-help">
          Las coordenadas privadas son internas. El sitio público utiliza únicamente las coordenadas
          públicas.
        </p>

        <div class="admin-field">
          <label for="field-precision">Precisión pública</label>
          <select id="field-precision" name="locationPrecision">
            {
              PRECISION_OPTIONS.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))
            }
          </select>
          <p class="editor-help" id="field-precision-note" hidden>
            Introduce manualmente la ubicación aproximada que podrá mostrarse públicamente.
          </p>
        </div>

        <div class="editor-row">
          <div class="admin-field">
            <label for="field-public-lat">Latitud pública</label>
            <input
              type="text"
              inputmode="decimal"
              id="field-public-lat"
              name="publicLatitude"
              aria-describedby="public-coords-help field-public-lat-error"
              aria-invalid="false"
            />
            <p class="editor-error" id="field-public-lat-error" hidden></p>
          </div>
          <div class="admin-field">
            <label for="field-public-lng">Longitud pública</label>
            <input
              type="text"
              inputmode="decimal"
              id="field-public-lng"
              name="publicLongitude"
              aria-describedby="public-coords-help field-public-lng-error"
              aria-invalid="false"
            />
            <p class="editor-error" id="field-public-lng-error" hidden></p>
          </div>
        </div>
      </fieldset>

      <section class="editor-language" aria-labelledby="lang-es-heading">
        <div class="editor-language-head">
          <h2 id="lang-es-heading">Español</h2>
          <span class="admin-badge editor-language-status" id="lang-es-status" data-status="empty">
            Sin contenido
          </span>
        </div>

        <div class="admin-field">
          <label for="field-es-title">Título</label>
          <input type="text" id="field-es-title" name="es.title" maxlength="200" />
        </div>

        <div class="admin-field">
          <label for="field-es-slug">Slug</label>
          <div class="editor-slug">
            <input
              type="text"
              id="field-es-slug"
              name="es.slug"
              aria-describedby="field-es-slug-error"
              aria-invalid="false"
            />
            <button type="button" class="admin-button" data-generate-slug="es">
              Generar desde el título en español
            </button>
          </div>
          <p class="editor-error" id="field-es-slug-error" hidden></p>
        </div>

        <div class="admin-field">
          <label for="field-es-marketing">Descripción comercial</label>
          <textarea id="field-es-marketing" name="es.marketingDescription" rows="5"></textarea>
        </div>

        <div class="admin-field">
          <label for="field-es-technical">Descripción técnica</label>
          <textarea id="field-es-technical" name="es.technicalDescription" rows="5"></textarea>
        </div>
      </section>

      <section class="editor-language" aria-labelledby="lang-en-heading">
        <div class="editor-language-head">
          <h2 id="lang-en-heading">English</h2>
          <span class="admin-badge editor-language-status" id="lang-en-status" data-status="empty">
            Sin contenido
          </span>
        </div>

        <p class="editor-help">Opcional. Puedes completar la versión en inglés más adelante.</p>

        <div class="admin-field">
          <label for="field-en-title">Title</label>
          <input type="text" id="field-en-title" name="en.title" maxlength="200" />
        </div>

        <div class="admin-field">
          <label for="field-en-slug">Slug</label>
          <div class="editor-slug">
            <input
              type="text"
              id="field-en-slug"
              name="en.slug"
              aria-describedby="field-en-slug-error"
              aria-invalid="false"
            />
            <button type="button" class="admin-button" data-generate-slug="en">
              Generar desde el título en inglés
            </button>
          </div>
          <p class="editor-error" id="field-en-slug-error" hidden></p>
        </div>

        <div class="admin-field">
          <label for="field-en-marketing">Marketing description</label>
          <textarea id="field-en-marketing" name="en.marketingDescription" rows="5"></textarea>
        </div>

        <div class="admin-field">
          <label for="field-en-technical">Technical description</label>
          <textarea id="field-en-technical" name="en.technicalDescription" rows="5"></textarea>
        </div>
      </section>

      <p class="editor-error" id="editor-form-error" role="alert" hidden></p>

      <div class="editor-actions">
        <button type="submit" class="admin-button admin-button-primary" id="editor-save">
          Guardar cambios
        </button>
        <p class="editor-save-status" id="editor-save-status" role="status" data-state="saved">
          Guardado
        </p>
      </div>
    </form>

    <section
      class="editor-features admin-panel"
      id="editor-features"
      aria-labelledby="features-heading"
      hidden
    >
      <h2 id="features-heading">Características</h2>
      <p class="editor-help">
        Añade datos personalizados como dormitorios, acceso, servicios, vistas o cualquier detalle
        relevante.
      </p>

      <div id="admin-features">
        <p class="admin-muted">Cargando características…</p>
      </div>
    </section>

    <section
      class="editor-media admin-panel"
      id="editor-media"
      aria-labelledby="media-heading"
      hidden
    >
      <h2 id="media-heading">Multimedia</h2>
      <p class="editor-help">
        Sube fotos, panoramas 360°, documentos y vídeos, o añade un vídeo de YouTube por su
        identificador.
      </p>

      <div id="admin-media">
        <p class="admin-muted">Cargando archivos…</p>
      </div>
    </section>

    <section class="editor-tour admin-panel" id="editor-tour" aria-labelledby="tour-heading" hidden>
      <h2 id="tour-heading">Recorrido 360°</h2>
      <p class="editor-help">
        Encadena los panoramas de la propiedad: elige el punto de inicio y coloca los saltos de uno
        a otro sobre el propio panorama.
      </p>

      <div id="admin-tour">
        <p class="admin-muted">Cargando recorrido…</p>
      </div>
    </section>

    <section class="editor-review admin-panel" id="editor-review" aria-labelledby="review-heading">
      <h2 id="review-heading">Revisión</h2>
      <p class="editor-help">
        Genera un enlace temporal para que alguien de fuera vea la ficha sin publicarla y decida.
        Aprobarla no la publica.
      </p>

      <div id="admin-review">
        <p class="admin-muted">Cargando revisión…</p>
      </div>
    </section>
  </div>
</AdminLayout>

<script>
  import { initEditorPage } from '../../../lib/admin/ui/editor-page';
  import { initReviewPanel } from '../../../lib/admin/ui/review-panel';

  initEditorPage();
  initReviewPanel();
</script>
