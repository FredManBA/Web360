---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Field from '../../../components/admin/Field.astro';
import { getDb } from '../../../db/client';
import { getProperty, propertyMedia } from '../../../lib/admin/core';
import { parseRouteId } from '../../../lib/admin/http/guard';
import {
  TYPE_LABELS,
  SYSTEM_PROPERTY_TYPE_KEYS,
  COMMERCIAL_STATUSES,
} from '../../../lib/domain/vocabularies';
import { formatMinorAsDecimal } from '../../../lib/domain/money';
import { COMMERCIAL_STATUS_LABELS } from '../../../lib/admin/ui/labels';
export const prerender = false;
const id = parseRouteId(Astro.params.id);
const db = getDb(env);
const p = id === null ? undefined : await getProperty(db, id);
const files = p ? await propertyMedia(db, p.id) : [];
if (!p) Astro.response.status = 404;
---

<AdminLayout title={p ? `Editar ${p.code}` : 'Propiedad no encontrada'}>
  <p><a href="/admin/propiedades">← Propiedades</a></p>
  {
    p && (
      <>
        <div class="r2-actions">
          <>
            <strong id="r2-publication-state">
              {p.status === 'published' ? 'Publicada' : 'Borrador'}
            </strong>
            <button
              type="button"
              id="r2-publish"
              class="admin-button admin-button-primary"
              hidden={p.status === 'published'}
            >
              Publicar propiedad
            </button>
            <a
              id="r2-view"
              class="admin-button"
              href={`/es/propiedades/${p.slugEs ?? ''}`}
              hidden={p.status !== 'published' || !p.slugEs}
            >
              Ver propiedad
            </a>
            <button
              type="button"
              id="r2-withdraw"
              class="admin-button"
              hidden={p.status !== 'published'}
            >
              Retirar
            </button>
          </>
        </div>
        <p id="r2-status" role="status" aria-live="polite" />
        <form id="r2-property" data-id={p.id}>
          <section class="admin-panel">
            <>
              <h2>Información</h2>
              <p>
                Código: <strong>{p.code}</strong>
              </p>
              <div class="r2-grid">
                <Field
                  name="type"
                  label="Tipo"
                  value={p.type}
                  options={SYSTEM_PROPERTY_TYPE_KEYS.map((value) => ({
                    value,
                    label: TYPE_LABELS.es[value],
                  }))}
                />
                <Field
                  name="commercialStatus"
                  label="Estado comercial"
                  value={p.commercialStatus}
                  options={COMMERCIAL_STATUSES.map((value) => ({
                    value,
                    label: COMMERCIAL_STATUS_LABELS[value],
                  }))}
                />
                <Field name="featured" label="Destacada" type="checkbox" value={p.featured} />
                <Field
                  name="priceMode"
                  label="Precio"
                  value={p.priceMode}
                  options={[
                    { value: 'contact', label: 'Consultar' },
                    { value: 'exact', label: 'Exacto' },
                    { value: 'negotiable', label: 'Negociable' },
                  ]}
                />
                <Field name="currencyCode" label="Moneda (USD / CRC)" value={p.currencyCode} />
                <Field
                  name="priceAmount"
                  label="Importe"
                  value={
                    p.priceAmountMinor === null || !p.currencyCode
                      ? ''
                      : formatMinorAsDecimal(p.priceAmountMinor, p.currencyCode)
                  }
                />
                <Field
                  name="areaSquareMeters"
                  label="Superficie (m²)"
                  type="number"
                  value={p.areaSquareMeters}
                />
                <>
                  <Field name="province" label="Provincia" value={p.province} />
                  <Field name="canton" label="Cantón" value={p.canton} />
                  <Field name="district" label="Distrito" value={p.district} />
                  <Field name="locality" label="Localidad" value={p.locality} />
                </>
                <>
                  <Field
                    name="mapLatitude"
                    label="Latitud del mapa"
                    type="number"
                    value={p.mapLatitude}
                  />
                  <Field
                    name="mapLongitude"
                    label="Longitud del mapa"
                    type="number"
                    value={p.mapLongitude}
                  />
                </>
                <Field
                  name="locationPrecision"
                  label="Ubicación"
                  value={p.locationPrecision}
                  options={[
                    { value: 'approximate', label: 'Aproximada' },
                    { value: 'exact', label: 'Exacta' },
                  ]}
                />
              </div>
              <p>La coordenada guardada es la que se muestra en el mapa público.</p>
            </>
          </section>
          <section class="admin-panel">
            <>
              <h2>Español</h2>
              <Field name="titleEs" label="Título" value={p.titleEs} />
              <Field name="slugEs" label="Slug" value={p.slugEs} />
              <Field
                name="descriptionEs"
                label="Descripción"
                type="textarea"
                value={p.descriptionEs}
              />
              <Field name="detailsEs" label="Detalles" type="textarea" value={p.detailsEs} />
            </>
          </section>
          <section class="admin-panel">
            <>
              <h2>English (opcional)</h2>
              <Field name="titleEn" label="Title" value={p.titleEn} />
              <Field name="slugEn" label="Slug EN" value={p.slugEn} />
              <Field
                name="descriptionEn"
                label="Description"
                type="textarea"
                value={p.descriptionEn}
              />
              <Field name="detailsEn" label="Details" type="textarea" value={p.detailsEn} />
            </>
          </section>
          <section class="admin-panel">
            <>
              <h2>Características</h2>
              <div id="r2-features">
                {p.featuresJson.map((feature) => (
                  <div class="r2-row" data-row>
                    {(['label_es', 'label_en', 'value_es', 'value_en'] as const).map(
                      (key, index) => (
                        <label>
                          {['Etiqueta ES', 'Label EN', 'Valor ES', 'Value EN'][index]}
                          <input data-key={key} value={feature[key] ?? ''} />
                        </label>
                      ),
                    )}
                    <div class="r2-actions">
                      <button
                        type="button"
                        data-row-action="up"
                        class="admin-button"
                        aria-label="Subir característica"
                      >
                        ↑
                      </button>
                      <button
                        type="button"
                        data-row-action="down"
                        class="admin-button"
                        aria-label="Bajar característica"
                      >
                        ↓
                      </button>
                      <button type="button" data-row-action="remove" class="admin-button">
                        Eliminar
                      </button>
                    </div>
                  </div>
                ))}
              </div>
              <button id="r2-add-feature" class="admin-button" type="button">
                Añadir característica
              </button>
            </>
          </section>
          <button type="submit" class="admin-button admin-button-primary" id="r2-save">
            Guardar cambios
          </button>
        </form>
        <template id="r2-feature-template">
          <div class="r2-row" data-row>
            <>
              <label>
                Etiqueta ES
                <input data-key="label_es" />
              </label>
              <label>
                Label EN
                <input data-key="label_en" />
              </label>
              <label>
                Valor ES
                <input data-key="value_es" />
              </label>
              <label>
                Value EN
                <input data-key="value_en" />
              </label>
              <div class="r2-actions">
                <>
                  <button
                    type="button"
                    data-row-action="up"
                    class="admin-button"
                    aria-label="Subir característica"
                  >
                    ↑
                  </button>
                  <button
                    type="button"
                    data-row-action="down"
                    class="admin-button"
                    aria-label="Bajar característica"
                  >
                    ↓
                  </button>
                  <button type="button" data-row-action="remove" class="admin-button">
                    Eliminar
                  </button>
                </>
              </div>
            </>
          </div>
        </template>
        <section class="admin-panel">
          <h2>Fotos y multimedia</h2>
          <>
            <form id="r2-upload" class="r2-actions">
              <>
                <label>
                  Tipo
                  <select name="kind">
                    <>
                      <option value="image">Imagen</option>
                      <option value="panorama">Panorama 360</option>
                    </>
                  </select>
                </label>
                <label>
                  Archivo
                  <input
                    type="file"
                    name="file"
                    accept="image/jpeg,image/png,image/webp"
                    required
                  />
                </label>
                <button class="admin-button" type="submit">
                  Subir
                </button>
              </>
            </form>
            <p>JPG, PNG o WebP. Imagen: hasta 12 MB; panorama: hasta 30 MB.</p>
          </>
          <form id="r2-youtube" class="r2-actions">
            <>
              <label>
                ID de YouTube
                <input name="youtubeVideoId" pattern="[A-Za-z0-9_-]{11}" required maxlength="11" />
              </label>
              <button class="admin-button" type="submit">
                Añadir YouTube
              </button>
            </>
          </form>
          <div id="r2-media" class="r2-grid" />
          <script
            is:inline
            id="r2-media-data"
            type="application/json"
            set:html={JSON.stringify(files).replace(/</g, '\\u003c')}
          />
        </section>
        <section class="admin-panel" id="r2-tour" data-id={p.id}>
          <h2>Recorrido 360</h2>
          <p id="r2-tour-empty" hidden={p.tourJson !== null}>
            Todavía no hay recorrido. Añade un panorama para empezar; una propiedad puede publicarse
            sin él.
          </p>
          <div class="r2-tour">
            <div>
              <ul class="r2-tour-nodes" id="r2-tour-nodes" />
              <div class="r2-actions">
                <label>
                  Añadir panorama
                  <select id="r2-tour-add" />
                </label>
                <button type="button" class="admin-button" id="r2-tour-add-button">
                  Añadir al recorrido
                </button>
              </div>
              <p>Los panoramas se suben en «Fotos y multimedia».</p>
            </div>
            <div>
              {/* Nodo permanente: el visor vive aquí y nunca se sustituye. */}
              <div class="r2-tour-viewer" id="tour-viewer" hidden />
              <p id="r2-tour-hint" role="status" aria-live="polite" />
              <div class="r2-actions">
                <label>
                  Enlazar con
                  <select id="r2-tour-link-target" />
                </label>
                <button type="button" class="admin-button" id="r2-tour-link">
                  Añadir enlace
                </button>
                <label>
                  <input type="checkbox" id="r2-tour-return" />
                  Crear también regreso
                </label>
                <button type="button" class="admin-button" id="r2-tour-cancel" hidden>
                  Cancelar
                </button>
              </div>
              <div class="r2-actions">
                <button type="button" class="admin-button" id="r2-tour-view">
                  Usar esta vista como inicial
                </button>
                <button type="button" class="admin-button" id="r2-tour-start">
                  Marcar como inicio
                </button>
                <button type="button" class="admin-button" id="r2-tour-preview">
                  Vista previa
                </button>
                <button type="button" class="admin-button" id="r2-tour-remove">
                  Quitar del recorrido
                </button>
              </div>
              <div id="r2-tour-detail" />
            </div>
          </div>
          <p id="r2-tour-status" role="status" aria-live="polite" />
          <button type="button" class="admin-button admin-button-primary" id="r2-tour-save">
            Guardar recorrido
          </button>
          <script
            is:inline
            id="r2-tour-data"
            type="application/json"
            set:html={JSON.stringify(p.tourJson ?? null).replace(/</g, '\\u003c')}
          />
        </section>
      </>
    )
  }
</AdminLayout>
<script>
  import { initEditor } from '../../../lib/admin/ui/simple';
  import { initTour } from '../../../lib/admin/ui/tour';
  initEditor();
  initTour();
</script>
