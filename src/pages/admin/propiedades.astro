---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../db/client';
import { listProperties } from '../../lib/admin/core';
import { TYPE_LABELS } from '../../lib/domain/vocabularies';
import { formatPrice } from '../../lib/public/read-model';
import { COMMERCIAL_STATUS_LABELS } from '../../lib/admin/ui/labels';
export const prerender = false;
const rows = await listProperties(getDb(env));
---

<AdminLayout title="Propiedades" description="El catálogo y los borradores, en un solo lugar.">
  <div class="admin-toolbar">
    <label
      >Mostrar <select id="r2-filter"
        ><option value="">Todas</option><option value="draft">Borradores</option><option
          value="published">Publicadas</option
        ></select
      ></label
    >
    <button id="r2-create" type="button" class="admin-button admin-button-primary"
      >Nueva propiedad</button
    >
  </div>
  <p id="r2-status" role="status" aria-live="polite"></p>
  <div class="admin-panel r2-table-scroll">
    {
      rows.length === 0 ? (
        <p class="admin-empty">Todavía no hay propiedades. Crea la primera para empezar.</p>
      ) : (
        <table class="admin-table">
          <caption>{rows.length === 1 ? '1 propiedad' : `${rows.length} propiedades`}</caption>
          <thead>
            <tr>
              <th scope="col">Propiedad</th>
              <th scope="col">Tipo</th>
              <th scope="col">Publicación</th>
              <th scope="col">Estado comercial</th>
              <th scope="col">Precio</th>
              <th scope="col">Actualizada</th>
              <th scope="col">
                <span class="visually-hidden">Acciones</span>
              </th>
            </tr>
          </thead>
          <tbody>
            {rows.map((p) => (
              <tr data-property-status={p.status}>
                <td>
                  <a class="admin-table-title" href={`/admin/propiedades/${p.id}`}>
                    {p.titleEs ?? 'Sin título'}
                  </a>
                  <br />
                  <span class="admin-table-code">{p.code}</span>
                </td>
                <td>{TYPE_LABELS.es[p.type]}</td>
                <td>
                  <span class="admin-badge" data-state={p.status}>
                    {p.status === 'published' ? 'Publicada' : 'Borrador'}
                  </span>
                </td>
                <td>
                  <span class="admin-badge" data-state={p.commercialStatus}>
                    {COMMERCIAL_STATUS_LABELS[p.commercialStatus]}
                  </span>
                </td>
                <td>{formatPrice(p.priceMode, p.priceAmountMinor, p.currencyCode, 'es').text}</td>
                <td class="admin-table-muted">{p.updatedAt.toLocaleDateString('es-CR')}</td>
                <td>
                  <div class="admin-table-actions">
                    <a class="admin-button" href={`/admin/propiedades/${p.id}`}>
                      Editar
                    </a>
                    {p.status === 'published' && p.slugEs && (
                      <a class="admin-button" href={`/es/propiedades/${p.slugEs}`}>
                        Ver
                      </a>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
  </div>
</AdminLayout>
<script>
  import { initList } from '../../lib/admin/ui/simple';
  initList();
</script>
