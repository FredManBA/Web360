---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../db/client';
import { listProperties } from '../../lib/admin/core';
import { TYPE_LABELS } from '../../lib/domain/vocabularies';
import { formatPrice } from '../../lib/public/read-model';
import { COMMERCIAL_STATUS_LABELS } from '../../lib/admin/ui/labels';
export const prerender = false;
const rows = await listProperties(getDb(env));
---

<AdminLayout title="Propiedades" description="El catálogo y los borradores, en un solo lugar.">
  <div class="r2-actions">
    <button id="r2-create" type="button" class="admin-button admin-button-primary"
      >Nueva propiedad</button
    >
    <label
      >Mostrar <select id="r2-filter"
        ><option value="">Todas</option><option value="draft">Borradores</option><option
          value="published">Publicadas</option
        ></select
      ></label
    >
  </div>
  <p id="r2-status" role="status" aria-live="polite"></p>
  <div class="admin-panel r2-table-scroll">
    <table class="admin-table">
      <caption>{rows.length} propiedades</caption>
      <thead
        ><tr
          ><th>Código</th><th>Título ES</th><th>Tipo</th><th>Publicación</th><th
            >Estado comercial</th
          ><th>Precio</th><th>Actualizada</th><th>Acciones</th></tr
        ></thead
      >
      <tbody
        >{
          rows.map((p) => (
            <tr data-property-status={p.status}>
              <>
                <td>{p.code}</td>
                <td>{p.titleEs ?? 'Sin título'}</td>
                <td>{TYPE_LABELS.es[p.type]}</td>
                <td>{p.status === 'published' ? 'Publicada' : 'Borrador'}</td>
                <td>{COMMERCIAL_STATUS_LABELS[p.commercialStatus]}</td>
                <td>{formatPrice(p.priceMode, p.priceAmountMinor, p.currencyCode, 'es').text}</td>
                <td>{p.updatedAt.toLocaleDateString('es-CR')}</td>
                <td>
                  <a href={`/admin/propiedades/${p.id}`}>Editar</a>
                  {p.status === 'published' && p.slugEs && (
                    <>
                      {' '}
                      · <a href={`/es/propiedades/${p.slugEs}`}>Ver</a>
                    </>
                  )}
                </td>
              </>
            </tr>
          ))
        }</tbody
      >
    </table>{rows.length === 0 && <p>Crea la primera propiedad para empezar.</p>}
  </div>
</AdminLayout>
<script>
  import { initList } from '../../lib/admin/ui/simple';
  initList();
</script>
