---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import Field from '../../components/admin/Field.astro';
import { getDb } from '../../db/client';
import { getSettings } from '../../lib/admin/core';
import { SITE_MEDIA_SLOTS, SITE_MEDIA_RULES } from '../../lib/domain/site-media';
import { COLUMN_BY_SLOT } from '../../lib/admin/settings/site-media';
export const prerender = false;
const s = await getSettings(getDb(env));
const business = [
  ['businessName', 'Nombre del negocio'],
  ['phone', 'Teléfono'],
  ['whatsapp', 'WhatsApp'],
  ['email', 'Correo público'],
  ['address', 'Dirección'],
  ['notificationsEmail', 'Correo de avisos'],
  ['defaultCurrencyCode', 'Moneda por defecto'],
] as const;
const texts = [
  ['brandTagline', 'Lema / Tagline'],
  ['heroTitle', 'Título de portada / Hero title'],
  ['heroSubtitle', 'Subtítulo / Subtitle'],
  ['seoTitle', 'Título SEO'],
  ['seoDescription', 'Descripción SEO'],
] as const;
---

<AdminLayout
  title="Configuración"
  description="Los cambios guardados aparecen al momento en el sitio público."
>
  <p id="r2-status" role="status" aria-live="polite"></p>
  <form id="r2-settings">
    <section class="admin-panel">
      <h2>Negocio y contacto</h2><div class="r2-grid">
        {
          business.map(([key, label]) => (
            <Field
              name={key}
              label={label}
              value={s?.[key] ?? (key === 'defaultCurrencyCode' ? 'USD' : '')}
            />
          ))
        }
      </div>
    </section>
    {
      (['Es', 'En'] as const).map((locale) => (
        <section class="admin-panel">
          <h2>{locale === 'Es' ? 'Español' : 'English'}</h2>
          {texts.map(([key, label]) => (
            <Field name={`${key}${locale}`} label={label} value={s?.[`${key}${locale}`]} />
          ))}
        </section>
      ))
    }
    <section class="admin-panel">
      <h2>Redes sociales</h2><div id="r2-social">
        {
          (s?.socialLinksJson ?? []).map((link) => (
            <div class="r2-row" data-row>
              <>
                <label>
                  Plataforma
                  <input data-key="platform" value={link.platform} />
                </label>
                <label>
                  URL
                  <input data-key="url" type="url" value={link.url} />
                </label>
                <div class="r2-actions">
                  <>
                    <button
                      type="button"
                      class="admin-button"
                      data-row-action="up"
                      aria-label="Subir red social"
                    >
                      ↑
                    </button>
                    <button
                      type="button"
                      class="admin-button"
                      data-row-action="down"
                      aria-label="Bajar red social"
                    >
                      ↓
                    </button>
                    <button type="button" class="admin-button" data-row-action="remove">
                      Eliminar
                    </button>
                  </>
                </div>
              </>
            </div>
          ))
        }
      </div><button id="r2-add-social" type="button" class="admin-button">Añadir red social</button>
    </section>
    <button type="submit" class="admin-button admin-button-primary">Guardar cambios</button>
  </form>
  <template id="r2-social-template"
    ><div class="r2-row" data-row>
      <label>Plataforma<input data-key="platform" /></label><label
        >URL<input data-key="url" type="url" /></label
      ><div class="r2-actions">
        <button
          type="button"
          class="admin-button"
          data-row-action="up"
          aria-label="Subir red social">↑</button
        ><button
          type="button"
          class="admin-button"
          data-row-action="down"
          aria-label="Bajar red social">↓</button
        ><button type="button" class="admin-button" data-row-action="remove">Eliminar</button>
      </div>
    </div></template
  >
  <section class="admin-panel">
    <h2>Identidad visual</h2><div class="r2-grid">
      {
        SITE_MEDIA_SLOTS.map((slot) => (
          <form data-site-slot={slot} class="r2-media-card">
            <>
              <h3>{SITE_MEDIA_RULES[slot].label}</h3>
              <img
                src={`/site-media/${slot}?v=${s?.updatedAt.getTime()}`}
                alt={SITE_MEDIA_RULES[slot].label}
                hidden={!s?.[COLUMN_BY_SLOT[slot]]}
              />
              <label>
                Nueva imagen
                <input name="file" type="file" accept="image/jpeg,image/png,image/webp" required />
              </label>
              <p>Máximo {Math.round(SITE_MEDIA_RULES[slot].maxBytes / 1024)} KB.</p>
              <div class="r2-actions">
                <>
                  <button type="submit" class="admin-button">
                    Subir imagen
                  </button>
                  <button type="button" class="admin-button" data-remove-slot>
                    Retirar imagen
                  </button>
                </>
              </div>
            </>
          </form>
        ))
      }
    </div>
  </section>
</AdminLayout>
<script>
  import { initSettings } from '../../lib/admin/ui/simple';
  initSettings();
</script>
