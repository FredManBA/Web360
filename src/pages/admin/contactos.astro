---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDb } from '../../db/client';
import { listContacts } from '../../lib/admin/core';
import { CONTACT_METHOD_LABELS } from '../../lib/admin/ui/labels';
export const prerender = false;
const contacts = await listContacts(getDb(env));
---

<AdminLayout title="Consultas" description="Mensajes recibidos desde el sitio.">
  <p id="r2-status" role="status" aria-live="polite"></p>
  {contacts.length === 0 && <p>No hay consultas todavía.</p>}
  {
    contacts.map((c) => (
      <article class="admin-panel">
        <>
          <h2>{c.name}</h2>
          <p>
            {c.propertyCode ?? 'Consulta general'} · {c.createdAt.toLocaleDateString('es-CR')} ·{' '}
            {c.locale.toUpperCase()}
          </p>
          <p>
            {CONTACT_METHOD_LABELS[c.preferredContactMethod]}: {c.contactValue}
          </p>
          <p class="r2-message">{c.message}</p>
          <button type="button" class="admin-button" data-contact-id={c.id} data-status={c.status}>
            {c.status === 'new' ? 'Marcar atendida' : 'Marcar sin atender'}
          </button>
        </>
      </article>
    ))
  }
</AdminLayout>
<script>
  import { initContacts } from '../../lib/admin/ui/simple';
  initContacts();
</script>
