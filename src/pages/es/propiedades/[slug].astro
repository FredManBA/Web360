---
import PropertyDetail from '../../../components/public/PropertyDetail.astro';
import PublicLayout from '../../../layouts/PublicLayout.astro';
import {
  alternateHref,
  catalogueOf,
  type PublicPropertyDetail,
} from '../../../lib/public/read-model';
import { brandOf, propertySeo } from '../../../lib/public/seo';
import { loadPublicSnapshot } from '../../../lib/public/snapshot';
import { propertyJsonLd } from '../../../lib/public/structured-data';

/*
 * Una ruta por cada propiedad publicada CON traduccion utilizable en este
 * idioma. Las que no la tienen simplemente no existen aqui: no se inventa el
 * slug ni se recurre al otro idioma.
 */
export function getStaticPaths() {
  const snapshot = loadPublicSnapshot();

  return catalogueOf(snapshot, 'es').map((property) => ({
    params: { slug: property.slug },
    props: {
      property: property as PublicPropertyDetail,
      // La misma ficha en el otro idioma, si esta traducida.
      alternate: alternateHref(snapshot, 'es', property.slug),
    },
  }));
}

const locale = 'es' as const;
const snapshot = loadPublicSnapshot();
const channels = snapshot.contact;
const { property, alternate } = Astro.props as {
  property: PublicPropertyDetail;
  alternate: string | null;
};

const seo = propertySeo(property, locale, brandOf(snapshot.site, locale), alternate);

/*
 * Las imagenes del JSON-LD son las rutas publicas de siempre (`/media/N`),
 * absolutas solo si hay dominio. Nunca una clave de R2.
 */
const url = (path: string): string =>
  Astro.site === undefined ? path : new URL(path, Astro.site).href;

const jsonLd = propertyJsonLd({
  property,
  locale,
  url: url(property.href),
  images: property.media.items
    .map((item) => item.url)
    .filter((item): item is string => item !== null)
    .map(url),
});
---

<PublicLayout seo={seo} section="properties" jsonLd={jsonLd}>
  <div class="page">
    <PropertyDetail property={property} locale={locale} channels={channels} />
  </div>
</PublicLayout>

<script>
  import { initPropertyDetail } from '../../../lib/public/detail-page';
  import { initLanguagePreference } from '../../../lib/public/language-preference';
  import { initContactForm } from '../../../lib/public/contact-form';
  import { initPropertyMap } from '../../../lib/public/map-page';

  initLanguagePreference();
  initContactForm();
  initPropertyDetail();
  initPropertyMap();
</script>
