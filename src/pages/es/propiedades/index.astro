---
import CatalogueControls from '../../../components/public/CatalogueControls.astro';
import PropertyCard from '../../../components/public/PropertyCard.astro';
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { labelsFor } from '../../../lib/public/labels';
import { catalogueHref, catalogueOf } from '../../../lib/public/read-model';
import { loadPublicSnapshot } from '../../../lib/public/snapshot';

/*
 * Pagina estatica. El catalogo sale del snapshot que se construye en el build;
 * en tiempo de ejecucion no se consulta nada. Los filtros trabajan despues
 * sobre estas mismas tarjetas, ya en el navegador.
 */
const locale = 'es' as const;
const labels = labelsFor(locale);

const snapshot = loadPublicSnapshot();
const properties = catalogueOf(snapshot, locale);
---

<PublicLayout
  locale={locale}
  title={labels.catalogueTitle}
  description={labels.catalogueDescription}
  section="properties"
  alternateHref={catalogueHref('en')}
>
  <div class="page">
    <header class="page-head">
      <h1>{labels.catalogueTitle}</h1>
      <p class="page-lead">{labels.catalogueDescription}</p>
    </header>

    {
      properties.length === 0 ? (
        <p class="state-empty">{labels.empty}</p>
      ) : (
        <div class="catalogue" id="catalogue">
          <CatalogueControls locale={locale} />

          <p
            class="catalogue-count"
            id="catalogue-count"
            role="status"
            data-template={labels.results(0).replace('0', '{n}')}
            data-template-one={labels.results(1)}
          >
            {labels.results(properties.length)}
          </p>

          <ul class="property-list" id="catalogue-list">
            {properties.map((property) => (
              <li>
                <PropertyCard property={property} locale={locale} />
              </li>
            ))}
          </ul>

          <div class="state-empty" id="catalogue-empty" hidden>
            <p>{labels.noMatches}</p>
            <p class="state-empty-hint">{labels.noMatchesHint}</p>
          </div>

          <div class="catalogue-more-row">
            <button
              type="button"
              class="button-outline"
              id="catalogue-more"
              data-label={labels.showMore}
              hidden
            >
              {labels.showMore}
            </button>
          </div>
        </div>
      )
    }
  </div>
</PublicLayout>

<script>
  import { initCataloguePage } from '../../../lib/public/catalogue-page';
  import { initLanguagePreference } from '../../../lib/public/language-preference';

  initCataloguePage();
  initLanguagePreference();
</script>
