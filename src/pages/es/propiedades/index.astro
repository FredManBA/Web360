---
import PropertyCard from '../../../components/public/PropertyCard.astro';
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { labelsFor } from '../../../lib/public/labels';
import { catalogueHref, catalogueOf } from '../../../lib/public/read-model';
import { brandOf, sectionSeo } from '../../../lib/public/seo';
import { loadRuntimePublicSnapshot } from '../../../lib/public/snapshot';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'no-store');
const locale = 'es' as const;
const labels = labelsFor(locale);

const snapshot = await loadRuntimePublicSnapshot();
const properties = catalogueOf(snapshot, locale);

const seo = sectionSeo({
  locale,
  brand: brandOf(snapshot.site, locale),
  socialImage: snapshot.site.media.social,
  title: labels.catalogueTitle,
  description: labels.catalogueDescription,
  path: catalogueHref('es'),
  alternatePath: catalogueHref('en'),
});
---

<PublicLayout site={snapshot.site} seo={seo} section="properties">
  <div class="page">
    <header class="page-head">
      <h1>{labels.catalogueTitle}</h1>
      <p class="page-lead">{labels.catalogueDescription}</p>
    </header>

    {
      properties.length === 0 ? (
        <p class="state-empty">{labels.empty}</p>
      ) : (
        <div class="catalogue">
          <p class="catalogue-count">{labels.results(properties.length)}</p>

          <ul class="property-list">
            {properties.map((property) => (
              <li>
                <PropertyCard property={property} locale={locale} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</PublicLayout>

<script>
  import { initLanguagePreference } from '../../../lib/public/language-preference';

  initLanguagePreference();
</script>
