---
import MapExplorer from '../../components/public/MapExplorer.astro';
import PublicLayout from '../../layouts/PublicLayout.astro';
import { labelsFor } from '../../lib/public/labels';
import { mapHref } from '../../lib/public/navigation';
import { catalogueOf } from '../../lib/public/read-model';
import { brandOf, sectionSeo } from '../../lib/public/seo';
import { loadPublicSnapshot } from '../../lib/public/snapshot';

/*
 * Pagina estatica, como el catalogo: las propiedades salen del snapshot que se
 * construye en el build, y en tiempo de ejecucion no se consulta nada. Que una
 * propiedad este aqui ya lo decidio `isPubliclyVisible` al construirlo.
 */
const locale = 'es' as const;
const labels = labelsFor(locale);

const properties = catalogueOf(loadPublicSnapshot(), locale);

const seo = sectionSeo({
  locale,
  brand: brandOf(loadPublicSnapshot().site, locale),
  title: labels.mapTitle,
  description: labels.mapDescription,
  path: mapHref('es'),
  alternatePath: mapHref('en'),
});
---

<PublicLayout seo={seo} section="map">
  <MapExplorer properties={properties} locale={locale} />
</PublicLayout>

<script>
  import { initLanguagePreference } from '../../lib/public/language-preference';
  import { initMapPage } from '../../lib/public/map-page';

  initLanguagePreference();
  initMapPage();
</script>
