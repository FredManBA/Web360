---
import '../styles/global.css';
import '../styles/admin.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;

/**
 * Solo se listan las secciones que existen de verdad. Cada una con un icono
 * de trazo sencillo (SVG en linea, sin libreria ni peticion).
 */
const sections = [
  {
    href: '/admin/propiedades',
    label: 'Propiedades',
    icon: 'M3 9.5 10 4l7 5.5V16a1 1 0 0 1-1 1h-3.5v-4.5h-5V17H4a1 1 0 0 1-1-1Z',
  },
  {
    href: '/admin/contactos',
    label: 'Consultas',
    icon: 'M3 5.5A1.5 1.5 0 0 1 4.5 4h11A1.5 1.5 0 0 1 17 5.5v9a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 3 14.5Zm0 .5 7 5 7-5',
  },
  {
    href: '/admin/configuracion',
    label: 'Configuración',
    icon: 'M4 6h7m4 0h1M4 14h1m4 0h7M13 4v4M7 12v4',
  },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href="/fonts/newsreader-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/hanken-grotesk-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!-- El panel no debe indexarse ni cachearse. -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Costa Rica 360</title>
  </head>

  <body class="admin">
    {
      /*
       * Primer elemento enfocable de la pagina, igual que en el sitio publico
       * y con la misma regla de `global.css`: invisible hasta que recibe el
       * foco. El panel repite la barra lateral en todas las pantallas, y sin
       * esto llegar al contenido con el teclado obliga a recorrerla entera
       * cada vez.
       */
    }
    <a class="skip-link" href="#admin-main">Saltar al contenido</a>

    <div class="admin-shell">
      <!-- Cabecera compacta, solo visible en movil. -->
      <div class="admin-topbar">
        <button
          type="button"
          class="admin-nav-toggle"
          id="admin-nav-toggle"
          aria-expanded="false"
          aria-controls="admin-nav"
        >
          <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
            <path
              d="M3 5h14M3 10h14M3 15h14"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"></path>
          </svg>
          <span id="admin-nav-toggle-text">Menú</span>
        </button>
        <span class="admin-brand">Costa Rica 360</span>
      </div>

      <aside class="admin-sidebar" id="admin-nav" data-open="false">
        <p class="admin-brand">
          Costa Rica 360
          <span>Panel de administración</span>
        </p>

        <nav aria-label="Secciones del panel" class="admin-nav">
          <ul>
            {
              sections.map((section) => (
                <li>
                  <a
                    href={section.href}
                    aria-current={currentPath.startsWith(section.href) ? 'page' : undefined}
                  >
                    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false">
                      <path
                        d={section.icon}
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {section.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="admin-sidebar-footer">
          <a href="/es/" target="_blank" rel="noopener">
            Ver el sitio público
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </aside>

      <div class="admin-main">
        <header class="admin-header">
          <h1>{title}</h1>
          {description && <p>{description}</p>}
        </header>

        <main class="admin-content" id="admin-main">
          <slot />
        </main>
      </div>
    </div>

    <script>
      /*
       * Navegacion movil. Sin libreria: un boton que alterna `data-open` y
       * mantiene `aria-expanded` sincronizado.
       */
      // Asercion en vez del generico: el tipo `Element` del runtime de Workers
      // choca con el del DOM.
      const toggle = document.querySelector('#admin-nav-toggle') as HTMLButtonElement | null;
      const nav = document.querySelector('#admin-nav') as HTMLElement | null;
      const toggleText = document.querySelector('#admin-nav-toggle-text') as HTMLElement | null;

      if (toggle !== null && nav !== null) {
        const setOpen = (open: boolean): void => {
          nav.dataset.open = String(open);
          toggle.setAttribute('aria-expanded', String(open));
          if (toggleText !== null) toggleText.textContent = open ? 'Cerrar' : 'Menú';
        };

        toggle.addEventListener('click', () => {
          setOpen(nav.dataset.open !== 'true');
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && nav.dataset.open === 'true') {
            setOpen(false);
            toggle.focus();
          }
        });
      }
    </script>
  </body>
</html>
