---
import '../styles/global.css';

import SiteHeader from '../components/public/SiteHeader.astro';
import SiteFooter from '../components/public/SiteFooter.astro';
import { labelsFor } from '../lib/public/labels';
import type { SectionId } from '../lib/public/navigation';
import type { JsonLd } from '../lib/public/structured-data';
import { absoluteUrl, ogLocale, otherLocale, type PageSeo } from '../lib/public/seo';
import type { PublicSite } from '../lib/public/read-model';

interface Props {
  site: Pick<PublicSite, 'businessName' | 'media'>;
  /** Todo lo que esta pagina declara sobre si misma. */
  seo: PageSeo;
  /** Seccion activa en la navegacion. */
  section?: SectionId;
  /** Datos estructurados, ya construidos por la pagina. */
  jsonLd?: JsonLd | null;
  /** Cabecera flotante sobre el hero: solo la portada la pide. */
  overlayHeader?: boolean;
}

const { site, seo, section, jsonLd = null, overlayHeader = false } = Astro.props;

/*
 * Las URL del `<head>` se emiten absolutas SOLO cuando el proyecto tiene un
 * dominio configurado (`site` en `astro.config.mjs`). Mientras no lo tenga
 * —y no lo tiene: el dominio es cosa del despliegue— se emiten relativas,
 * que son validas y resuelven bien. El dia que se configure, se vuelven
 * absolutas solas, sin tocar ninguna pagina.
 */
const url = (path: string): string => absoluteUrl(Astro.site, path);

const { locale } = seo;
const other = otherLocale(locale);

const brand = site.businessName ?? labelsFor(locale).brandName;

/*
 * Una pagina que no representa contenido —el 404— no tiene canonica. Sin
 * ella tampoco hay `og:url` ni alternates: no habria a que apuntar.
 */
const canonical = seo.path === null ? null : url(seo.path);
const image = seo.imagePath === null ? null : url(seo.imagePath);

/*
 * El favicon configurado, si lo hay. Sin el no se declara ninguno y el
 * navegador hace lo de siempre: pedir `/favicon.ico` y quedarse sin icono.
 */
const favicon = site.media.favicon;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href="/fonts/newsreader-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/hanken-grotesk-latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{seo.title}</title>
    {seo.description && <meta name="description" content={seo.description} />}

    {favicon && <link rel="icon" href={favicon} />}

    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={seo.indexable ? 'index, follow' : 'noindex, follow'} />

    {
      /*
       * Los dos idiomas se apuntan mutuamente SOLO cuando ambas versiones
       * existen: un `alternate` a una traduccion que no esta seria mandar a
       * la gente a un 404. Por eso se declaran los dos juntos o ninguno.
       */
      seo.alternatePath && canonical && (
        <>
          <link rel="alternate" hreflang={locale} href={canonical} />
          <link rel="alternate" hreflang={other} href={url(seo.alternatePath)} />
        </>
      )
    }

    {
      /*
       * La portada anade el `x-default`: es la unica pagina a la que se llega
       * sin haber elegido idioma.
       */
      seo.isHome && <link rel="alternate" hreflang="x-default" href={url('/es/')} />
    }

    <meta property="og:type" content={seo.type} />
    <meta property="og:site_name" content={brand} />
    <meta property="og:title" content={seo.title} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={ogLocale(locale)} />
    {seo.alternatePath && <meta property="og:locale:alternate" content={ogLocale(other)} />}
    {seo.description && <meta property="og:description" content={seo.description} />}
    {image && <meta property="og:image" content={image} />}
    {image && seo.imageAlt && <meta property="og:image:alt" content={seo.imageAlt} />}

    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={seo.title} />
    {seo.description && <meta name="twitter:description" content={seo.description} />}
    {image && <meta name="twitter:image" content={image} />}
    {image && seo.imageAlt && <meta name="twitter:image:alt" content={seo.imageAlt} />}

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />}
  </head>
  <body>
    <SiteHeader
      locale={locale}
      section={section}
      alternateHref={seo.alternatePath}
      brand={brand}
      logo={site.media.logo}
      overlay={overlayHeader}
    />

    <main id="contenido">
      <slot />
    </main>

    <SiteFooter
      locale={locale}
      brand={brand}
      logo={site.media.logo}
      alternateHref={seo.alternatePath}
    />
  </body>
</html>
