---
import '../styles/global.css';

import SiteHeader from '../components/public/SiteHeader.astro';
import SiteFooter from '../components/public/SiteFooter.astro';
import type { Locale } from '../lib/domain/vocabularies';
import type { SectionId } from '../lib/public/navigation';

interface Props {
  title: string;
  locale: Locale;
  description?: string;
  /** Seccion activa en la navegacion. */
  section?: SectionId;
  /** Esta misma pagina en el otro idioma, si existe. */
  alternateHref?: string | null;
  /** Ruta canonica de ESTA pagina. */
  canonical?: string | null;
  /** La portada declara ademas un `x-default` para quien llega a la raiz. */
  homeAlternates?: boolean;
}

const {
  title,
  locale,
  description,
  section,
  alternateHref = null,
  canonical = null,
  homeAlternates = false,
} = Astro.props;

/*
 * Las URL del `<head>` se emiten absolutas SOLO cuando el proyecto tiene un
 * dominio configurado (`site` en `astro.config.mjs`). Mientras no lo tenga
 * —y no lo tiene: el dominio es cosa del despliegue— se emiten relativas,
 * que son validas y resuelven bien. El dia que se configure, se vuelven
 * absolutas solas, sin tocar ninguna pagina.
 */
const absolute = (path: string): string =>
  Astro.site === undefined ? path : new URL(path, Astro.site).href;

const other: Locale = locale === 'es' ? 'en' : 'es';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={absolute(canonical)} />}

    {alternateHref && <link rel="alternate" hreflang={other} href={absolute(alternateHref)} />}

    {
      /*
       * La portada declara los dos idiomas y un `x-default`: es la unica
       * pagina a la que se llega sin haber elegido ninguno.
       */
      homeAlternates && canonical && (
        <>
          <link rel="alternate" hreflang={locale} href={absolute(canonical)} />
          <link rel="alternate" hreflang="x-default" href={absolute('/es/')} />
        </>
      )
    }
  </head>
  <body>
    <SiteHeader locale={locale} section={section} alternateHref={alternateHref} />

    <main id="contenido">
      <slot />
    </main>

    <SiteFooter locale={locale} />
  </body>
</html>
