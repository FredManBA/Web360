---
/**
 * Ficha publica de una propiedad.
 *
 * El orden esta pensado para quien mira, no para quien administra: primero la
 * fotografia a pantalla completa, despues lo que decide una visita —precio,
 * superficie, donde esta—, y solo entonces el detalle. El recorrido 360 va
 * arriba del todo porque es lo que distingue a este sitio.
 *
 * Nada de esto pide nada al servidor: todo sale del snapshot publico.
 */
import PropertyContact from './PropertyContact.astro';
import PropertyGallery from './PropertyGallery.astro';
import PropertyMap from './PropertyMap.astro';
import PropertyTour from './PropertyTour.astro';
import PropertyVideo from './PropertyVideo.astro';
import type { Locale } from '../../lib/domain/vocabularies';
import { commercialStatusLabel, labelsFor, locationLine } from '../../lib/public/labels';
import {
  catalogueHref,
  EMPTY_CONTACT,
  type PublicContactChannels,
  type PublicPropertyDetail,
} from '../../lib/public/read-model';

interface Props {
  property: PublicPropertyDetail;
  locale: Locale;
  /** Canales publicados; salen del snapshot, no del codigo. */
  channels?: PublicContactChannels;
}

const { property, locale, channels = EMPTY_CONTACT } = Astro.props;
const labels = labelsFor(locale);
const place = locationLine(property.location);

const images = property.media.items.filter((item) => item.kind === 'image');

/*
 * La que abre la galeria: la marcada como portada si es imagen, y si no la
 * primera. Se busca DENTRO de `images` en vez de usar `media.hero`: el
 * snapshot viaja serializado, asi que `hero` y su gemelo en `items` son dos
 * objetos distintos y compararlos por referencia pintaria la foto dos veces.
 */
const heroUrl = property.media.hero?.kind === 'image' ? property.media.hero.url : null;
const lead = images.find((image) => image.url === heroUrl) ?? images[0] ?? null;

// La portada abre la galeria, para que la primera foto sea la que se eligio.
const ordered = lead === null ? images : [lead, ...images.filter((image) => image !== lead)];

const videos = property.media.items.filter((item) => item.kind === 'video');
const documents = property.media.items.filter((item) => item.kind === 'document');

const tour = property.tour;
---

<article class="property-detail">
  <p class="property-crumb">
    <a href={catalogueHref(locale)}>
      <span aria-hidden="true">←</span>
      {labels.backToCatalogue}
    </a>
  </p>

  {
    ordered.length > 0 ? (
      <PropertyGallery
        images={ordered}
        locale={locale}
        propertyTitle={property.title}
        tourHref={tour === null ? null : '#recorrido'}
      />
    ) : (
      <p class="state-empty">{labels.noImages}</p>
    )
  }

  {
    /*
     * Dos columnas en escritorio: el contenido a la izquierda y, a la derecha,
     * lo que decide una visita —precio, superficie, donde esta— fijo mientras
     * se baja, con el camino a la consulta siempre a mano.
     */
  }
  <div class="property-layout">
    <div class="property-main">
      <header class="property-detail-head">
        <h1>{property.title}</h1>
        {place && <p class="property-detail-place place">{place}</p>}

        <p class="property-detail-meta">
          {property.propertyType && <span class="property-chip">{property.propertyType}</span>}
          {
            property.commercialStatus && (
              <span class="property-chip property-status">
                {commercialStatusLabel(property.commercialStatus, locale)}
              </span>
            )
          }
          <span class="property-code">{`${labels.code} ${property.code}`}</span>
        </p>
      </header>

      {
        tour && (
          <PropertyTour
            tour={tour}
            locale={locale}
            posterUrl={lead?.url ?? null}
            posterAlt={labels.imageOf(property.title)}
          />
        )
      }

      {
        property.marketingDescription && (
          <section class="property-section">
            <h2>{labels.description}</h2>
            <p class="property-prose">{property.marketingDescription}</p>
          </section>
        )
      }

      {
        property.features.length > 0 && (
          <section class="property-section property-section-wide">
            <h2>{labels.features}</h2>

            <div class="property-feature-groups">
              {property.features.map((group) => (
                <div class="property-feature-group">
                  {group.name && <h3>{group.name}</h3>}
                  <dl>
                    {group.items.map((item) => (
                      <>
                        <dt>{item.label}</dt>
                        <dd>{item.value ?? '—'}</dd>
                      </>
                    ))}
                  </dl>
                </div>
              ))}
            </div>
          </section>
        )
      }

      {
        videos.length > 0 && (
          <PropertyVideo videos={videos} locale={locale} propertyTitle={property.title} />
        )
      }

      {
        property.technicalDescription && (
          <section class="property-section">
            <h2>{labels.technical}</h2>
            <p class="property-prose">{property.technicalDescription}</p>
          </section>
        )
      }

      {
        documents.length > 0 && (
          <section class="property-section">
            <h2>{labels.documents}</h2>
            <ul class="property-link-list">
              {documents.map((document) => (
                <li>
                  <a href={document.url ?? '#'}>
                    {document.title ?? document.altText ?? labels.documents}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <PropertyMap property={property} locale={locale} />
    </div>

    <aside class="property-aside" aria-label={labels.overview}>
      {/* Lo que decide una visita, junto y sin ruido alrededor. */}
      <dl class="property-facts">
        <div class="property-fact property-fact-price">
          <dt>{labels.price}</dt>
          <dd>{property.price.text}</dd>
        </div>

        {
          property.area && (
            <div class="property-fact">
              <dt>{labels.area}</dt>
              <dd>{property.area.text}</dd>
            </div>
          )
        }

        {
          place && (
            <div class="property-fact">
              <dt>{labels.location}</dt>
              <dd class="place">{place}</dd>
            </div>
          )
        }
      </dl>

      <a class="property-aside-cta" href="#contacto">{labels.writeToUs}</a>
      {
        tour && (
          <a class="property-aside-tour" href="#recorrido">
            {labels.tourTitle}
          </a>
        )
      }
    </aside>
  </div>

  <PropertyContact property={property} channels={channels} locale={locale} />

  <p class="property-back">
    <a href={catalogueHref(locale)}>← {labels.backToCatalogue}</a>
  </p>
</article>
