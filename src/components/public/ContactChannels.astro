---
/**
 * Canales directos: WhatsApp, telefono, correo y redes.
 *
 * Solo se pinta lo que esta configurado y sirve. Nada esta escrito en el
 * codigo: todo sale de `site_settings`, que es donde lo cambia quien lleva el
 * negocio.
 *
 * WhatsApp abre con el mensaje ya escrito. Abrirlo NO crea ninguna consulta:
 * la conversacion ocurre en WhatsApp y aqui no se guarda nada.
 */
import type { Locale } from '../../lib/domain/vocabularies';
import { availableChannels, type WhatsappSubject } from '../../lib/public/contact';
import { labelsFor } from '../../lib/public/labels';
import type { PublicContactChannels } from '../../lib/public/read-model';

interface Props {
  channels: PublicContactChannels;
  locale: Locale;
  /** Propiedad por la que se pregunta, para el mensaje de WhatsApp. */
  subject?: WhatsappSubject | null;
  /** En la ficha el bloque es mas discreto y no lleva titulo propio. */
  compact?: boolean;
}

const { channels, locale, subject = null, compact = false } = Astro.props;
const labels = labelsFor(locale);

const direct = availableChannels(channels, locale, subject);

const CHANNEL_LABELS = {
  whatsapp: labels.contactWhatsapp,
  phone: labels.contactPhone,
  email: labels.contactEmail,
};
---

{
  (direct.length > 0 || channels.social.length > 0) && (
    <div class:list={['contact-channels', compact && 'contact-channels-compact']}>
      {!compact && <h2 class="contact-channels-title">{labels.contactChannels}</h2>}

      {direct.length > 0 && (
        <ul class="channel-list">
          {direct.map((channel) => (
            <li>
              <a
                class:list={['channel', `channel-${channel.kind}`]}
                href={channel.href}
                {...(channel.kind === 'whatsapp'
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                <span class="channel-kind">{CHANNEL_LABELS[channel.kind]}</span>
                <span class="channel-value">{channel.value}</span>
              </a>
            </li>
          ))}
        </ul>
      )}

      {channels.social.length > 0 && (
        <div class="channel-social">
          <h3>{labels.contactSocial}</h3>
          <ul>
            {channels.social.map((link) => (
              <li>
                <a href={link.url} rel="noopener noreferrer" target="_blank">
                  {link.platform}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  )
}
