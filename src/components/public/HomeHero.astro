---
/**
 * Hero de la portada.
 *
 * Con fotografia configurada, manda la fotografia. Sin ella, el fondo se
 * dibuja: un degradado de selva a marfil con unas curvas de nivel muy tenues
 * hechas con gradientes, sin una sola peticion de red. Ese respaldo no es un
 * apano: es lo que se ve mientras nadie sube una imagen, y sigue siendo una
 * portada presentable.
 *
 * La imagen es del SITIO, no de una propiedad: colgarla de la foto de un lote
 * la ataria a que ese lote siguiera publicado.
 *
 * Tres cosas que la fotografia no puede romper:
 *
 * - la legibilidad. El degradado oscuro sigue estando encima; el texto no
 *   depende de que la foto sea oscura;
 * - el salto de maquetacion. El hueco del hero lo fija el CSS y la imagen se
 *   coloca dentro con `object-fit`, asi que nada se mueve al cargar;
 * - la primera impresion. Es la imagen mas importante de la pagina, asi que
 *   se pide con prioridad alta y sin diferir.
 *
 * Los textos SI salen de la configuracion cuando estan escritos; lo que hay
 * en `labels` son valores por defecto, no contenido comercial fijado.
 */
import type { Locale } from '../../lib/domain/vocabularies';
import type { HomeCopy } from '../../lib/public/home';
import { labelsFor } from '../../lib/public/labels';
import { mapHref } from '../../lib/public/navigation';
import { catalogueHref } from '../../lib/public/read-model';

interface Props {
  copy: HomeCopy;
  locale: Locale;
  /** El mapa solo se ofrece si hay algo situado que mirar. */
  showMap?: boolean;
  /** Fotografia de portada configurada, si la hay. */
  image?: string | null;
}

const { copy, locale, showMap = false, image = null } = Astro.props;
const labels = labelsFor(locale);
---

<section class:list={['hero', image !== null && 'hero-has-image']}>
  {
    /*
     * Decoracion, no contenido: por eso `alt` vacio. Lo que hay que leer esta
     * en el titulo, que va justo debajo.
     */
    image !== null && (
      <img
        class="hero-image"
        src={image}
        alt=""
        fetchpriority="high"
        decoding="async"
        aria-hidden="true"
      />
    )
  }

  {/* El relieve es decoracion: no aporta nada que leer. */}
  <div class="hero-terrain" aria-hidden="true"></div>

  <div class="hero-inner">
    <p class="hero-brand">
      <span class="hero-brand-mark" aria-hidden="true">L</span>
      {copy.brand}
    </p>

    <h1 class="hero-title">{copy.heroTitle}</h1>
    <p class="hero-subtitle">{copy.heroSubtitle}</p>

    <div class="hero-actions">
      <a class="hero-cta" href={catalogueHref(locale)}>{labels.homeSeeProperties}</a>

      {
        showMap && (
          <a class="hero-cta hero-cta-quiet" href={mapHref(locale)}>
            {labels.homeSeeMap}
          </a>
        )
      }
    </div>

    {copy.tagline && <p class="hero-tagline">{copy.tagline}</p>}
  </div>
</section>
