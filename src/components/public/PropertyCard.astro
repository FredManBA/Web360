---
import PropertyImage from './PropertyImage.astro';
import type { Locale } from '../../lib/domain/vocabularies';
import { commercialStatusLabel, labelsFor, locationLine } from '../../lib/public/labels';
import type { PublicPropertyCard } from '../../lib/public/read-model';

interface Props {
  property: PublicPropertyCard;
  locale: Locale;
}

const { property, locale } = Astro.props;
const labels = labelsFor(locale);
const place = locationLine(property.location);

/*
 * La portada del catalogo es la que marco el editor. Si no hay ninguna, sirve
 * cualquier imagen de la propiedad antes que dejar la tarjeta desnuda.
 */
const cover =
  property.media.cover ?? property.media.items.find((item) => item.kind === 'image') ?? null;
---

{
  /*
  Los datos de filtrado viajan en el propio HTML: asi no hace falta duplicar el
  catalogo en un JSON aparte, y sin JavaScript la tarjeta se ve igual.
*/
}
<article
  class="property-card"
  data-catalogue-item
  data-slug={property.slug}
  data-type={property.propertyType ?? ''}
  data-zone={property.location.canton ?? ''}
  data-price={property.price.amountMinor ?? ''}
  data-currency={property.price.currencyCode ?? ''}
  data-surface={property.area?.squareMeters ?? ''}
>
  <a class="property-card-media" href={property.href} aria-hidden="true" tabindex="-1">
    {
      cover ? (
        <PropertyImage image={cover} locale={locale} propertyTitle={property.title} />
      ) : (
        <span class="property-card-placeholder" />
      )
    }
  </a>

  <h2 class="property-card-title">
    <a href={property.href}>{property.title}</a>
  </h2>

  <p class="property-card-meta">
    <span class="property-code">{labels.code} {property.code}</span>
    {property.propertyType && <span>{property.propertyType}</span>}
    {
      property.commercialStatus && (
        <span class="property-status">
          {commercialStatusLabel(property.commercialStatus, locale)}
        </span>
      )
    }
  </p>

  {place && <p class="property-card-place">{place}</p>}

  <p class="property-card-price">{property.price.text}</p>
  {
    property.area && (
      <p class="property-card-area">
        {labels.area}: {property.area.text}
      </p>
    )
  }
</article>
