---
/**
 * Explora Costa Rica.
 *
 * Un solo panel verde: a la izquierda un panorama 360 del sitio y a la
 * derecha el titulo, una frase y el camino al mapa. Los panoramas son del
 * sitio (`site_settings`, huecos `explore360_1..3`), no de ninguna propiedad:
 * se suben, reemplazan y retiran desde Configuracion.
 *
 * Mejora progresiva:
 *
 * - sin JavaScript se ve el panorama como foto recortada dentro del panel;
 * - con JavaScript el visor se crea al acercarse la seccion a la pantalla, y
 *   solo para el panorama visible;
 * - si el visor no arranca (sin WebGL, algunos iPhone), se queda la foto
 *   recortada. La portada nunca depende de WebGL para verse bien.
 *
 * Sin panoramas configurados, el panel sigue ahi con su texto: nunca se
 * rellena con propiedades.
 */
import type { Locale } from '../../lib/domain/vocabularies';
import { labelsFor } from '../../lib/public/labels';
import { mapHref } from '../../lib/public/navigation';

interface Props {
  locale: Locale;
  /** URLs publicas de los panoramas, ya ordenadas y sin huecos. */
  panoramas: string[];
  /** El mapa solo se ofrece si hay alguna propiedad situada. */
  showMap: boolean;
}

const { locale, panoramas, showMap } = Astro.props;
const labels = labelsFor(locale);
const total = panoramas.length;
const first = panoramas[0] ?? null;
/* Las posiciones anunciadas, ya traducidas: el modulo no importa la tabla. */
const positions = panoramas.map((_, index) => labels.homeExplorePosition(index + 1, total));
---

<section class="home-section home-explore" aria-labelledby="home-explore-title">
  <div class="explore-panel">
    <div
      class:list={['explore-visual', first === null && 'explore-visual-empty']}
      id="explore"
      data-panoramas={JSON.stringify(panoramas)}
      data-positions={JSON.stringify(positions)}
    >
      {
        first !== null && (
          <>
            <img
              class="explore-still"
              id="explore-still"
              src={first}
              alt={labels.homeExploreAlt}
              loading="lazy"
              decoding="async"
            />
            <div class="explore-viewer" id="explore-viewer" hidden />
          </>
        )
      }

      {
        total > 1 && (
          <div class="explore-controls" id="explore-controls" hidden>
            <button
              type="button"
              class="explore-arrow"
              id="explore-prev"
              aria-label={labels.homeExplorePrevious}
            >
              <span aria-hidden="true">←</span>
            </button>
            <p class="explore-position" id="explore-position" aria-live="polite">
              <span aria-hidden="true">1 / {total}</span>
              <span class="visually-hidden">{positions[0]}</span>
            </p>
            <button
              type="button"
              class="explore-arrow"
              id="explore-next"
              aria-label={labels.homeExploreNext}
            >
              <span aria-hidden="true">→</span>
            </button>
          </div>
        )
      }
    </div>

    <div class="explore-body">
      <h2 id="home-explore-title">{labels.homeExploreTitle}</h2>
      <p>{labels.homeExploreLead}</p>
      {
        showMap && (
          <a class="home-link explore-map-link" href={mapHref(locale)}>
            {labels.homeSeeMap} →
          </a>
        )
      }
    </div>
  </div>
</section>
