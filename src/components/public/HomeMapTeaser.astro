---
/**
 * Invitacion al mapa.
 *
 * Aqui NO se carga Mapbox: la portada no monta un mapa, solo lleva al que ya
 * existe. El dibujo es una silueta de Costa Rica en SVG inline, trazada desde
 * unas cuarenta coordenadas reales de costa y fronteras (x = lon + 86,
 * y = 11.3 - lat, por 100): se reconoce el pais sin una peticion de red.
 * Es decoracion; la marca no senala ninguna propiedad.
 */
import type { Locale } from '../../lib/domain/vocabularies';
import { labelsFor } from '../../lib/public/labels';
import { mapHref } from '../../lib/public/navigation';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const labels = labelsFor(locale);
---

<section class="home-map" aria-labelledby="home-map-title">
  <div class="home-map-art" aria-hidden="true">
    <svg class="home-map-country" viewBox="0 0 352 336" focusable="false">
      <path
        class="home-map-land"
        d="M30 23 38 11 110 35 132 22 165 31 180 51 210 59 235 37 260 90 297 130 322 160 343 173 323 190 307 222 328 237 307 287 311 327 285 270 265 260 270 292 227 272 235 245 227 215 184 187 137 169 137 152 117 132 100 122 75 108 88 128 107 148 98 158 89 174 80 163 33 136 16 100 8 40Z"
      ></path>
      <g class="home-map-pin" transform="translate(192 137)">
        <circle r="14"></circle>
        <circle r="4.5"></circle>
      </g>
    </svg>
  </div>

  <div class="home-map-body">
    <h2 id="home-map-title">{labels.homeMapTitle}</h2>
    <p>{labels.homeMapLead}</p>
    <a class="home-link" href={mapHref(locale)}>{labels.homeSeeMap} →</a>
  </div>
</section>
