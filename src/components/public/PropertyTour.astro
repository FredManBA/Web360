---
/**
 * Recorrido 360 publico.
 *
 * El visor (Photo Sphere Viewer y Three) pesa varios cientos de kilobytes y no
 * se carga al abrir la ficha: llega solo cuando alguien pulsa el boton. Quien
 * pasa por la pagina y no entra al recorrido no paga nada por el.
 *
 * Cuando el visor no es una opcion, la seccion no se rompe:
 *
 * - sin JavaScript, el marco no aparece y queda la presentacion del recorrido;
 * - si el visor no arranca —sin WebGL, navegador viejo, red caida— se queda el
 *   poster y se dice que no se pudo abrir.
 *
 * No hay enlaces a los panoramas sueltos: la imagen equirectangular cruda no se
 * entiende fuera del visor.
 *
 * Los datos del recorrido viajan incrustados en la propia pagina: es lo que ya
 * publica el snapshot, no hay una peticion mas y no aparece ni una clave de R2
 * ni un id de la base.
 */
import type { Locale } from '../../lib/domain/vocabularies';
import { labelsFor } from '../../lib/public/labels';
import type { PublicTour } from '../../lib/public/read-model';

interface Props {
  tour: PublicTour;
  locale: Locale;
  /** Imagen con la que se presenta el recorrido antes de abrirlo. */
  posterUrl?: string | null;
  posterAlt?: string;
}

const { tour, locale, posterUrl = null, posterAlt = '' } = Astro.props;
const labels = labelsFor(locale);

/*
 * `<` escapado: el JSON va dentro de un `<script>` y una cadena que contuviera
 * `</script>` cerraria la etiqueta antes de tiempo.
 */
const tourJson = JSON.stringify(tour).replace(/</g, '\\u003c');

/*
 * Los pocos textos que el visor necesita, con el hueco marcado donde va el
 * nombre o el numero. Viajan aparte para que el modulo del navegador no tenga
 * que importar la tabla de textos entera del sitio.
 */
const tourLabels = JSON.stringify({
  point: labels.tourPointName(0).replace('0', '{n}'),
  goTo: labels.tourGoTo('{name}'),
  current: labels.tourCurrentPoint,
  unavailable: labels.tourUnavailable,
  loading: labels.tourLoading,
});
---

<section class="property-tour" id="recorrido" aria-labelledby="tour-title">
  <div class="property-tour-head">
    <h2 id="tour-title">{labels.tourTitle}</h2>
    <p class="property-tour-lead">{labels.tourLead}</p>
    <p class="property-tour-count">{labels.tourPointCount(tour.nodes.length)}</p>
  </div>

  {/* El marco solo aparece si hay JavaScript: sin el no habria nada que abrir. */}
  <div class="tour-frame" id="tour-frame" hidden>
    {
      posterUrl && (
        <img class="tour-poster" id="tour-poster" src={posterUrl} alt={posterAlt} loading="lazy" />
      )
    }

    <div class="tour-viewer" id="tour-viewer" hidden></div>

    <button type="button" class="tour-open" id="tour-open">
      {/* Solo la forma: el triangulo de "play" se dibuja en CSS. */}
      <span class="tour-open-mark" aria-hidden="true"></span>
      <span>{labels.tourOpen}</span>
    </button>
  </div>

  <p class="tour-status" id="tour-status" role="status" hidden></p>

  <div class="tour-nav" id="tour-nav" hidden>
    <p class="tour-current" id="tour-current" aria-live="polite"></p>

    {
      /*
      Los saltos tambien como botones, no solo como marcas dentro del
      panorama: una marca flotante no la alcanza quien navega con teclado ni la
      anuncia un lector de pantalla.
    */
    }
    <ul class="tour-nav-list" id="tour-nav-list"></ul>

    <button type="button" class="tour-close" id="tour-close">{labels.tourClose}</button>
  </div>

  <script is:inline type="application/json" id="tour-data" set:html={tourJson} />
  <script is:inline type="application/json" id="tour-labels" set:html={tourLabels} />
</section>
