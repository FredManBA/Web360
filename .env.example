# CodeLoba - variables del BUILD del sitio publico (plantilla).
#
# Copia este archivo como `.env` y rellena los valores reales.
# `.env` esta en .gitignore y NUNCA debe subirse al repositorio.
#
# Ojo con la diferencia:
#   .env       -> lo lee Vite durante el build. Las variables `PUBLIC_*` se
#                 incrustan en el HTML/JS que llega al navegador.
#   .dev.vars  -> lo lee el Worker en ejecucion (Access, bypass del panel).
#                 Nada de aqui llega al navegador.

# Token PUBLICO de Mapbox (empieza por `pk.`), para los mapas del sitio.
#
# Es publico por definicion: viaja al navegador, como en cualquier sitio que
# use Mapbox. Restringelo por dominio (URL restrictions) en el panel de
# Mapbox. NUNCA pongas aqui un token secreto (`sk.`).
#
# Si falta, el sitio se construye igual: los mapas se quedan en su
# alternativa de texto y el listado sigue funcionando.
PUBLIC_MAPBOX_TOKEN=

# ---------------------------------------------------------------------------
# Build de una version candidata de publicacion
# ---------------------------------------------------------------------------
#
# Estas NO se ponen en `.env` para el desarrollo normal: las usa el runner que
# construye y despliega (ver `docs/publicacion.md`). Aqui figuran solo para
# saber que existen y para que sirven. NUNCA pongas valores reales.

# `local` (por defecto) o `remote`. Con `remote` el build lee la D1 de
# produccion por su API HTTP; si no puede leerla, el build falla en vez de
# generar un sitio vacio.
CODELOBA_D1_SOURCE=

# Numero de la operacion de publicacion que se esta construyendo. Con el, el
# build genera la version candidata de ESA operacion y embebe su manifiesto.
CODELOBA_PUBLICATION_REQUEST=

# Cuenta de Cloudflare, base D1 y token de SOLO LECTURA sobre D1, para el
# origen remoto del build. El token no necesita permiso de escritura.
CF_ACCOUNT_ID=
CF_D1_DATABASE_ID=
CF_API_TOKEN=

# Commit del que se construye. Solo diagnostico: viaja en el manifiesto y no
# decide nada. En GitHub Actions no hace falta ponerlo (`GITHUB_SHA` ya esta).
CODELOBA_RELEASE_COMMIT=
