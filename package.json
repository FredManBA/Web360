{
  "name": "codeloba",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "CodeLoba - sitio de propiedades sobre Astro + Cloudflare Workers.",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "astro check",
    "astro": "astro",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply codeloba-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply codeloba-db --remote",
    "cf:typegen": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "astro": "^7.3.1",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/parser": "^8.69.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-plugin-astro": "^3.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.69.0",
    "wrangler": "^4.129.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260903.1": true
  }
}
